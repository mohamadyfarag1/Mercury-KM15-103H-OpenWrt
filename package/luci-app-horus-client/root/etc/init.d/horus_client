#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/horus-radius.py

start_service() {
    # Guard: python3 is required at runtime. Without it procd enters an
    # infinite respawn loop and spams the system log. Abort gracefully.
    if ! command -v python3 >/dev/null 2>&1; then
        logger -t horus "python3 not found — service will not start. Install python3-light."
        return 1
    fi

    # Auto-Restore backup only if config file is completely missing or empty
    if [ ! -s /etc/config/horus_controller ]; then
        if [ -s /etc/horus_controller.bak ]; then
            cp -f /etc/horus_controller.bak /etc/config/horus_controller 2>/dev/null
        fi
    fi

    # Ensure UDP port 8885 is open in firewall for HMP discovery across all zones
    if ! uci -q get firewall.horus_hmp >/dev/null; then
        uci -q set firewall.horus_hmp=rule
        uci -q set firewall.horus_hmp.name='Allow-Horus-HMP'
        uci -q set firewall.horus_hmp.src='*'
        uci -q set firewall.horus_hmp.proto='udp'
        uci -q set firewall.horus_hmp.dest_port='8885'
        uci -q set firewall.horus_hmp.target='ACCEPT'
        uci -q commit firewall
        /etc/init.d/firewall reload 2>/dev/null
    fi

    config_load horus_controller
    config_get_bool enabled main enabled 0
    config_get role main role "standalone"
    config_get base_url main base_url ""
    config_get hmp_secret main hmp_secret ""

    # Auto-Backup valid user configuration
    if [ -n "$base_url" ] || [ "$role" != "standalone" ]; then
        cp -f /etc/config/horus_controller /etc/horus_controller.bak 2>/dev/null
    fi

    if [ "$enabled" -eq 1 ]; then
        # Start RADIUS Sync Daemon
        procd_open_instance "radius"
        procd_set_param command "$PROG"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    else
        echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
        rm -f /tmp/sas_token.txt
    fi
    
    config_get_bool neighbors_enabled main neighbors_enabled 1

    if [ "$role" != "standalone" ] || [ "$neighbors_enabled" -eq 1 ]; then
        # Start HMP Controller Daemon
        procd_open_instance "hmp"
        procd_set_param command /usr/bin/horus-hmp.py
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
}

stop_service() {
    pkill -TERM -f 'horus-hmp\.py|horus-radius\.py' 2>/dev/null
    sleep 1
    pkill -9 -f 'horus-hmp\.py|horus-radius\.py' 2>/dev/null
    echo '{"status":"disabled","data":[]}' > /tmp/horus_radius.json
    rm -f /tmp/sas_token.txt
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "horus_controller"
}
