#!/bin/sh
. /usr/lib/horus/cgi_auth.sh || exit 1
horus_require_auth read
printf "Content-Type: application/json\r\nCache-Control: no-cache, no-store, must-revalidate\r\nPragma: no-cache\r\nExpires: 0\r\n\r\n"

# Fast path: read from stamp file written by 99_horus-controller-patch
if [ -f /tmp/horus_pkg_version ]; then
    VER=$(cat /tmp/horus_pkg_version 2>/dev/null | tr -d '\n\r ')
fi

if [ -z "$VER" ] && [ -f /etc/horus_version ]; then
    VER=$(cat /etc/horus_version 2>/dev/null | tr -d '\n\r ')
fi

# Fallback: query opkg (slower)
if [ -z "$VER" ] || [ "$VER" = "0" ]; then
    VER=$(opkg status luci-app-horus-client 2>/dev/null | grep -i '^Version:' | awk '{print $2}' | head -n 1)
fi

if [ -z "$VER" ]; then
    VER="1.2.161"
fi

printf '{"version":"%s"}\n' "$VER"
