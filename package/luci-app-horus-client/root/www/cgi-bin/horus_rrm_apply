#!/bin/sh
. /usr/lib/horus/cgi_auth.sh || exit 1
horus_require_auth write
printf "Content-Type: application/json; charset=utf-8\r\n"
printf "Cache-Control: no-cache\r\n"
printf "\r\n"

if [ -z "$CONTENT_LENGTH" ] || [ "$CONTENT_LENGTH" -eq 0 ]; then
    printf '{"success":false,"error":"Empty request body"}\n'
    exit 0
fi

BODY=$(head -c "$CONTENT_LENGTH")
NEW_CH=$(echo "$BODY" | jsonfilter -e '@.channel' 2>/dev/null)

if [ -z "$NEW_CH" ] || ! echo "$NEW_CH" | grep -Eq '^[0-9]+$'; then
    printf '{"success":false,"error":"Invalid channel"}\n'
    exit 0
fi

DEV_NAME="radio0"
for dev in $(uci -q show wireless | grep '=wifi-device' | cut -d'.' -f2 | cut -d'=' -f1); do
    band=$(uci -q get wireless."$dev".band)
    hwmode=$(uci -q get wireless."$dev".hwmode)
    if [ "$band" = "5g" ] || [ "$band" = "6g" ] || [ "$hwmode" = "11a" ] || [ "$hwmode" = "11ac" ] || [ "$hwmode" = "11ax" ]; then
        DEV_NAME="$dev"
        break
    fi
    case "$dev" in
        *5*|*1*) DEV_NAME="$dev"; break ;;
    esac
done

PREV_CH=$(uci -q get wireless."$DEV_NAME".channel)
[ -z "$PREV_CH" ] && PREV_CH="auto"
echo "$PREV_CH" > /tmp/horus_rrm_prev_ch.txt

uci set wireless."$DEV_NAME".channel="$NEW_CH"
uci commit wireless
(sleep 1 && wifi reload) >/dev/null 2>&1 &

printf '{"success":true,"message":"تم تغيير التردد إلى قناة %s بنجاح"}\n' "$NEW_CH"
