#!/bin/sh
. /usr/lib/horus/cgi_auth.sh || exit 1
horus_require_auth read
printf "Content-Type: application/json\r\nCache-Control: no-cache\r\n\r\n"

# 1. Check if horus-hmp daemon is running
if ! pidof python3 >/dev/null 2>&1 || ! ps | grep -v grep | grep -q "horus-hmp.py"; then
    printf '{"status":"offline","message":"خدمة حورس متوقفة"}\n'
    exit 0
fi

# 2. Check if Layer 2 Controller heartbeat exists and is fresh (< 60s)
if [ -f /tmp/horus_controller_info.json ]; then
    NOW=$(date +%s)
    LAST_HB=$(jsonfilter -i /tmp/horus_controller_info.json -e '@.last_heartbeat' 2>/dev/null)
    if [ -n "$LAST_HB" ] && [ "$((NOW - LAST_HB))" -lt 60 ]; then
        cat /tmp/horus_controller_info.json
        exit 0
    fi
fi

# 3. If Controller IP is configured
CIP=$(uci -q get horus_controller.main.controller_ip)
if [ -n "$CIP" ]; then
    # We can't guarantee L3 reachability here trivially, but we can say we are sending to it.
    printf '{"status":"online","mode":"Direct IP","controller_ip":"%s","controller_hostname":"Controller"}\n' "$CIP"
    exit 0
fi

# 4. If running in Layer 2 Auto-Discovery mode and no heartbeat received
printf '{"status":"offline","message":"جاري البحث عن الكنترولر (L2 Auto-Discovery)..."}\n'
