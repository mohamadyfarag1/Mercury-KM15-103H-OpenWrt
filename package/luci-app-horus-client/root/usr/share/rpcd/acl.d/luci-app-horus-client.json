{
	"luci-app-horus-client": {
		"description": "Grant access to Horus Client configuration",
		"read": {
			"cgi-io": [ "exec" ],
			"file": [ "/tmp/horus_network_state.json" ],
			"uci": [ "horus_controller" ]
		},
		"write": {
			"file": [ "/tmp/horus_network_state.json" ],
			"uci": [ "horus_controller" ]
		}
	}
}