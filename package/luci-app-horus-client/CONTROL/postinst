#!/bin/sh
# Restore user configuration if upgraded, or fallback to persistent backup
if [ -s /tmp/horus_controller.saved ]; then
    cp -f /tmp/horus_controller.saved /etc/config/horus_controller 2>/dev/null
    rm -f /tmp/horus_controller.saved 2>/dev/null
elif [ -s /etc/horus_controller.bak ]; then
    if [ ! -s /etc/config/horus_controller ]; then
        cp -f /etc/horus_controller.bak /etc/config/horus_controller 2>/dev/null
    fi
fi

# Clean up any leftover -opkg file from previous upgrades
rm -f /etc/config/horus_controller-opkg 2>/dev/null

# Create default config only if not present or empty
if [ ! -s /etc/config/horus_controller ]; then
    cat << 'EOF' > /etc/config/horus_controller
config settings 'main'
    option enabled '0'
    option role 'satellite'
    option controller_ip ''
    option hmp_secret ''
    option radius_type 'sas'
    option base_url ''
    option username ''
    option password ''
    option api_key ''
    option api_port '8728'
    option sync_interval '10'
    option neighbors_enabled '1'
    option neighbors_interval '30'
    option log_level 'warning'
EOF
fi

uci -q get horus_controller.main.api_port >/dev/null 2>&1 || uci set horus_controller.main.api_port='8728'
uci -q get horus_controller.main.neighbors_enabled >/dev/null 2>&1 || uci set horus_controller.main.neighbors_enabled='1'
uci -q get horus_controller.main.neighbors_interval >/dev/null 2>&1 || uci set horus_controller.main.neighbors_interval='30'
uci -q get horus_controller.main.log_level >/dev/null 2>&1 || uci set horus_controller.main.log_level='warning'
uci commit horus_controller 2>/dev/null

# Open UDP port 8885 in firewall for HMP discovery
if ! uci -q get firewall.horus_hmp >/dev/null; then
    uci -q set firewall.horus_hmp=rule
    uci -q set firewall.horus_hmp.name='Allow-Horus-HMP'
    uci -q set firewall.horus_hmp.src='*'
    uci -q set firewall.horus_hmp.proto='udp'
    uci -q set firewall.horus_hmp.dest_port='8885'
    uci -q set firewall.horus_hmp.target='ACCEPT'
    uci -q commit firewall
    /etc/init.d/firewall reload >/dev/null 2>&1
fi

# Clean up leftover opkg conffile backup (harmless but confusing)
rm -f /etc/config/horus_controller-opkg 2>/dev/null

if ! command -v python3 >/dev/null 2>&1; then
    (
        sleep 2
        if ping -c 1 -W 3 8.8.8.8 >/dev/null 2>&1; then
            opkg update >/dev/null 2>&1
            opkg install python3-light >/dev/null 2>&1 || opkg install python3 >/dev/null 2>&1
            /etc/init.d/horus_client start >/dev/null 2>&1
        fi
    ) >/dev/null 2>&1 &
fi
rm -rf /tmp/luci-* 2>/dev/null
pkill -9 -f 'horus-hmp\.py|horus-radius\.py' 2>/dev/null
chmod +x /www/cgi-bin/* /usr/bin/horus-* /etc/init.d/horus_client /etc/uci-defaults/* 2>/dev/null
if [ -f /etc/uci-defaults/99_horus-controller-patch ]; then
    chmod +x /etc/uci-defaults/99_horus-controller-patch
    /bin/sh /etc/uci-defaults/99_horus-controller-patch >/dev/null 2>&1
fi
/etc/init.d/horus_client enable 2>/dev/null
/etc/init.d/horus_client start 2>/dev/null
rm -rf /tmp/luci-* /tmp/luci-indexcache* /tmp/luci-modulecache* /tmp/horus_controller_info.json 2>/dev/null
# Only reload rpcd if the ACL definition actually changed. Reloading it
# unconditionally on every single install/upgrade resets rpcd's session
# table, invalidating every admin's active LuCI login on this device --
# their dashboard/status endpoints start 403'ing until they log back in,
# on EVERY device, after EVERY update. See AI_AGENT_RULES.md.
ACL_FILE='/usr/share/rpcd/acl.d/luci-app-horus-client.json'
ACL_HASH_FILE='/etc/.horus_acl_hash'
NEW_ACL_HASH=$(md5sum "$ACL_FILE" 2>/dev/null | cut -d' ' -f1)
OLD_ACL_HASH=$(cat "$ACL_HASH_FILE" 2>/dev/null)
if [ -n "$NEW_ACL_HASH" ] && [ "$NEW_ACL_HASH" != "$OLD_ACL_HASH" ]; then
    /etc/init.d/rpcd reload >/dev/null 2>&1 || /etc/init.d/rpcd restart >/dev/null 2>&1
    echo "$NEW_ACL_HASH" > "$ACL_HASH_FILE"
fi
# No uhttpd restart: CGI scripts execute fresh on every request with no
# caching to invalidate, and static JS/CSS assets are already cache-busted
# via renamed filenames + ?v=<version> query strings (see rule 4). A full
# uhttpd restart bought nothing here but more post-upgrade disruption.

for h in /usr/lib/lua/luci/view/themes/*/header.htm; do
    if [ -f "$h" ]; then
        if ! grep -q "horus_augment.js" "$h"; then
            sed -i 's|</head>|<script src="/luci-static/resources/horus_client/horus_augment.js"></script>\n</head>|' "$h"
        fi
    fi
done

exit 0
