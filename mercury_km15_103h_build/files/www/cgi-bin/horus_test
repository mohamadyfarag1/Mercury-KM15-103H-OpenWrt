test_mikrotik() {
    OUT=$(python3 -c "
import json, sys
sys.path.insert(0, '/usr/lib')
try:
    from horus.radius.mikrotik import MikrotikApiClient
    host = '$BASE_URL'.replace('http://','').replace('https://','').split(':')[0].strip('/')
