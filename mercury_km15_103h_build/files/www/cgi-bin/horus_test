test_icm() {
    BASE=$(echo "$BASE_URL" | sed 's:/*$::')
    case "$BASE" in
        http://*|https://*) ;;
        *) BASE="https://$BASE" ;;
    esac
    case "$BASE" in
        */api/users/list|*/api/users/list/) BASE="${BASE%/}/index.php" ;;
        *.php) ;;
        *) BASE="${BASE}/api/users/list/index.php" ;;
    esac

    [ -z "$API_KEY" ] && API_KEY="7f3a9c5e2d8b4f6a1e7c3b9d5f2a8e4c"

    OUT=$(python3 -c "
import sys, json
sys.path.insert(0, '/usr/lib')
from horus.radius.http import http_req, custom_urlencode

url = '$BASE'
params = custom_urlencode({
    'username': '''$USERNAME''',
    'password': '''$PASSWORD''',
    'key': '''$API_KEY''',
    'limit': '1',
})
res = http_req(f'{url}?{params}', timeout=8)
if not res or not isinstance(res, dict):
    print(json.dumps({'success': False, 'message': 'تعذر الاتصال بسيرفر ICM', 'details': 'Timeout or Network Error'}))
elif res.get('status') == 'success':
    tot = res.get('data', {}).get('pagination', {}).get('total_items', 0)
    print(json.dumps({'success': True, 'message': '✅ ICM متصل بنجاح!', 'details': f'المشتركين: {tot}'}))
else:
    msg = res.get('message') or 'بيانات الدخول غير صحيحة'
    print(json.dumps({'success': False, 'message': f'فشل الاتصال بـ ICM: {msg}', 'details': str(res)}))
" 2>/dev/null)

    if [ -n "$OUT" ]; then
        echo "$OUT"
    else
        printf '{"success":false,"message":"فشل اختبار اتصال ICM","details":"تأكد من الرابط والمفتاح وبيانات الدخول"}\n'
    fi
}

