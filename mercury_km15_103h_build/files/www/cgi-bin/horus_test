# ── Run ──────────────────────────────────────────────
case "$RTYPE" in
    sas) test_sas ;;
    dma) test_dma ;;
    adv) test_adv ;;
    icm) test_icm ;;
    um7) test_um7 ;;
    freenet) test_freenet ;;
    mikrotik) test_mikrotik ;;
    *) printf '{"success":false,"message":"نوع سيرفر غير معروف: %s"}\n' "$RTYPE" ;;
esac
