#!/bin/sh
. /usr/lib/horus/cgi_auth.sh || exit 1
horus_require_auth read
printf "Content-Type: application/json; charset=utf-8\r\n\r\n"

lua -e '
local function exec(cmd)
    local f = io.popen(cmd)
    local r = f and f:read("*a") or ""
    if f then f:close() end
    return r
end

local dev, iface = nil, nil
for d in exec("uci show wireless"):gmatch("wireless%.([^%.]+)=wifi%-device") do
    local b = exec("uci -q get wireless."..d..".band"):gsub("%s+","")
    local h = exec("uci -q get wireless."..d..".hwmode"):gsub("%s+","")
    if b=="5g" or b=="6g" or h:match("11a") or d:match("5") or d:match("1") then
        dev = d
        break
    end
end

if not dev then
    print([[{"has_5g":false, "status":"no_5g", "message_ar":"لا يوجد كرت وايرليس 5GHz في هذا الجهاز"}]])
    os.exit(0)
end

local ifc = exec("uci -q show wireless | grep -E \"\\.device=.?\""..dev.."\"?$\" | cut -d. -f2 | head -n1"):gsub("%s+","")
if ifc ~= "" then
    local ifname = exec("uci -q get wireless."..ifc..".ifname"):gsub("%s+","")
    if ifname ~= "" then iface = ifname end
end
if not iface then iface = "wlan1" end

local info = exec("iwinfo "..iface.." info 2>/dev/null")
if info == "" then info = exec("iwinfo wlan0 info 2>/dev/null"); iface="wlan0" end

local cur_ch = tonumber(info:match("Channel:%s+(%d+)") or exec("uci -q get wireless."..dev..".channel"):gsub("%s+","")) or 36
local cur_noise = tonumber(info:match("Noise:%s+(%-?%d+)")) or -90
local htmode = exec("uci -q get wireless."..dev..".htmode"):gsub("%s+","")
if htmode=="" then htmode="VHT80" end

local cur_status, cur_status_ar
if cur_noise <= -88 then
    cur_status = "excellent"
    cur_status_ar = "ممتاز 🟢 (طيف نقي ومستقر)"
elseif cur_noise <= -82 then
    cur_status = "moderate"
    cur_status_ar = "متوسط 🟡 (تشويش خفيف)"
else
    cur_status = "noisy"
    cur_status_ar = "تشويش عالي 🔴 (يؤثر على البنج والسرعة)"
end

local is_rec = false
local reason_ar = "القناة الحالية ("..cur_ch..") تعمل بأعلى كفاءة واستقرار ممكن ولا داعي للتغيير حالياً."
local best_ch = cur_ch
local imp = 0

-- If noise is bad, find a better channel from standard non-DFS candidates
if cur_noise > -86 then
    local cands = {36,40,44,48,149,153,157,161}
    for _, c in ipairs(cands) do
        if c ~= cur_ch then
            best_ch = c
            imp = math.floor(((cur_noise + 95) / 15) * 100) -- pseudo-improvement score
            if imp > 95 then imp = 95 end
            if imp < 15 then imp = 15 end
            is_rec = true
            reason_ar = "القناة الحالية ("..cur_ch..") تعاني من تشويش ("..cur_noise.." dBm)، بينما القناة ("..best_ch..") أنظف بنسبة +"..imp.."%."
            break
        end
    end
end

print(string.format([[
{
  "has_5g": true,
  "current_channel": %d,
  "current_noise": %d,
  "current_status": "%s",
  "current_status_ar": "%s",
  "recommended_channel": %d,
  "improvement_pct": %d,
  "is_switch_recommended": %s,
  "reason_ar": "%s",
  "local": {"htmode": "%s"}
}
]], cur_ch, cur_noise, cur_status, cur_status_ar, best_ch, imp, tostring(is_rec), reason_ar, htmode))
' 2>/dev/null || printf '{"has_5g":false, "error":"Failed to run RRM Lua"}'
