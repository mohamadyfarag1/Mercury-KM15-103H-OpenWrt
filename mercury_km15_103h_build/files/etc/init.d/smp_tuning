#!/bin/sh /etc/rc.common
# =====================================================================
# Mercury KM15-103H - MT7621AT Quad-Thread Multi-Core SMP & IRQ Optimizer
#
# Hardware: MediaTek MT7621AT (2 Physical Cores, 4 Virtual Threads / VPEs @ 880MHz)
#
# Workload Distribution:
#   CPU 0 (Mask 0x1): OS Kernel, Netifd, LuCI Web UI, Hostapd Management, DNS/DHCP
#   CPU 1 (Mask 0x2): Gigabit Ethernet & MT7530 Switch Queues
#   CPU 2 (Mask 0x4): MT7915E PCIe Host Interface (HIF) + Hardware Crypto
#   CPU 3 (Mask 0x8): MT7915E Wi-Fi Radio Processing (the hot path)
#
# Verify with:  for i in /proc/irq/*/smp_affinity; do echo "$i $(cat $i)"; done
# Expect mt7915e-hif on 4 and mt7915e on 8 - if both read 8, this script
# did not run or its patterns stopped matching.
#
# Packet Steering (RPS & XPS):
#   Spreads network & Wi-Fi flow hash processing across Cores 1, 2, 3 (Mask 0xE)
# =====================================================================

START=98
STOP=10

start() {
    logger -t mercury-smp "Applying optimized MT7621AT Quad-Thread SMP & IRQ affinity..."

    # 1. Distribute Ethernet IRQ (1e100000.ethernet) -> CPU 1 (Mask 2)
    local eth_irq=$(awk -F: '/(1e100000\.ethernet|ethernet)/ {print $1}' /proc/interrupts | tr -d ' ')
    for irq in $eth_irq; do
        [ -d "/proc/irq/$irq" ] && echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
    done

    # 2. Distribute MT7530 Switch IRQ -> CPU 1 (Mask 2)
    local sw_irq=$(awk -F: '/mt7530/ {print $1}' /proc/interrupts | tr -d ' ')
    for irq in $sw_irq; do
        [ -d "/proc/irq/$irq" ] && echo 2 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
    done

    # 3. Wi-Fi PCIe HIF IRQ (mt7915e-hif) -> CPU 2 (Mask 4)
    #
    # Both WiFi patterns are anchored with $. /proc/interrupts names the
    # two interrupts "mt7915e-hif" and "mt7915e", so an unanchored
    # /mt7915/ matches BOTH - which is what step 4 used to do. It ran
    # after this one and overwrote the HIF affinity, landing the bus
    # interface and the radio on CPU 3 together while CPU 2 sat idle:
    #     irq 31 aff=8  mt7915e-hif      (should have been 4)
    #     irq 32 aff=8  mt7915e
    local hif_irq=$(awk -F: '$0 ~ /mt7915e-hif$/ {print $1}' /proc/interrupts | tr -d ' ')
    for irq in $hif_irq; do
        [ -d "/proc/irq/$irq" ] && echo 4 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
    done

    # 4. Wi-Fi Radio IRQ (mt7915e) -> CPU 3 (Mask 8)
    local wifi_irq=$(awk -F: '$0 ~ /mt7915e$/ {print $1}' /proc/interrupts | tr -d ' ')
    for irq in $wifi_irq; do
        [ -d "/proc/irq/$irq" ] && echo 8 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
    done

    # 5. Hardware Crypto Engine IRQ (1e004000.crypto) -> CPU 2 (Mask 4)
    #
    # Pairs with the HIF rather than the radio. The radio IRQ carries the
    # entire WiFi datapath (27,990 interrupts against the HIF's 0 on a
    # quiet box), so CPU 3 is the one core that must not share.
    local crypto_irq=$(awk -F: '$0 ~ /crypto$/ {print $1}' /proc/interrupts | tr -d ' ')
    for irq in $crypto_irq; do
        [ -d "/proc/irq/$irq" ] && echo 4 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
    done

    # 6. Enable Receive Packet Steering (RPS) across CPU 1, 2, 3 (Mask 0xE = 14)
    # CPU 0 is kept responsive for management, LuCI web server, and userland commands
    for rps in /sys/class/net/*/queues/rx-*/rps_cpus; do
        [ -f "$rps" ] && echo "e" > "$rps" 2>/dev/null || true
    done

    # 7. Enable Transmit Packet Steering (XPS) across CPU 1, 2, 3 (Mask 0xE)
    for xps in /sys/class/net/*/queues/tx-*/xps_cpus; do
        [ -f "$xps" ] && echo "e" > "$xps" 2>/dev/null || true
    done

    # 8. Enable Flow Offloading in Firewall (Hardware PPE NAT Acceleration)
    if [ -x /sbin/uci ]; then
        local changed=0
        if [ "$(uci -q get firewall.@defaults[0].flow_offloading)" != "1" ]; then
            uci set firewall.@defaults[0].flow_offloading="1"
            changed=1
        fi
        if [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" != "1" ]; then
            uci set firewall.@defaults[0].flow_offloading_hw="1"
            changed=1
        fi
        if [ "$changed" = "1" ]; then
            uci commit firewall
            /etc/init.d/firewall reload 2>/dev/null || true
        fi
    fi

    logger -t mercury-smp "MT7621AT Quad-Thread multi-core optimization applied successfully."
}

boot() {
    start
}
