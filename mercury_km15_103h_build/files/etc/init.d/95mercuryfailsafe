#!/bin/sh /etc/rc.common
#
# Mercury KM15-103H dual-slot boot failsafe.
#
# U-Boot on this device does not expose an interactive console (button/serial
# break does not stop it), so there is no bootloader-level fallback if a new
# sysupgrade image boots but comes up broken. This script is the software
# safety net for that case: mercury_do_upgrade() (lib/upgrade/mercury.sh)
# leaves a "pending_boot" marker in the Userdata/priv_data volume naming the
# previous slot. On every boot, if that marker is present, we wait up to
# MERCURY_FAILSAFE_TIMEOUT seconds for the box to become manageable
# (LAN up + dropbear/ssh listening); if it never does, we flip the Config
# boot-slot flag back to the previous slot and reboot. A full kernel panic /
# non-boot on the new slot is NOT covered by this (nothing on this device can
# run code from Linux userspace if the kernel never comes up) - only a
# "boots but broken" failure is caught here.
#
# Run 'mercury-confirm-boot' over SSH any time before the timeout to commit
# immediately instead of waiting.

START=99
STOP=01

MERCURY_FAILSAFE_TIMEOUT=300
MERCURY_FAILSAFE_POLL=10

boot() {
	( mercury_failsafe_run >/tmp/mercury-failsafe.log 2>&1 & ) >/dev/null 2>&1
}

mercury_failsafe_run() {
	. /lib/upgrade/mercury.sh

	if ! mercury_mount_data; then
		echo "Mercury-Failsafe: priv_data unavailable, nothing to check"
		return 0
	fi

	if [ ! -f "$MERCURY_DATA_MOUNT/pending_boot" ]; then
		mercury_umount_data
		return 0
	fi

	local prev_slot new_slot
	prev_slot="$(sed -n 's/^prev_slot=//p' "$MERCURY_DATA_MOUNT/pending_boot")"
	new_slot="$(sed -n 's/^new_slot=//p' "$MERCURY_DATA_MOUNT/pending_boot")"
	mercury_umount_data

	if [ -z "$prev_slot" ] || [ -z "$new_slot" ]; then
		echo "Mercury-Failsafe: malformed pending_boot marker, ignoring"
		return 0
	fi

	echo "Mercury-Failsafe: candidate boot on slot $new_slot (previous slot: $prev_slot). Watching for $MERCURY_FAILSAFE_TIMEOUT s..."
	echo "Mercury-Failsafe: run 'mercury-confirm-boot' over SSH to commit immediately."

	local elapsed=0
	while [ "$elapsed" -lt "$MERCURY_FAILSAFE_TIMEOUT" ]; do
		if mercury_pending_cleared; then
			echo "Mercury-Failsafe: confirmed manually (mercury-confirm-boot), committing slot $new_slot"
			return 0
		fi

		if mercury_looks_healthy; then
			echo "Mercury-Failsafe: management plane healthy, committing slot $new_slot"
			mercury_clear_pending
			return 0
		fi

		sleep "$MERCURY_FAILSAFE_POLL"
		elapsed=$((elapsed + MERCURY_FAILSAFE_POLL))
	done

	echo "Mercury-Failsafe: NOT healthy after ${MERCURY_FAILSAFE_TIMEOUT}s, reverting to slot $prev_slot"
	local config_mtd_num
	config_mtd_num=$(mercury_get_mtd_num "Config")
	if [ -z "$config_mtd_num" ]; then
		echo "Mercury-Failsafe: ERROR - Config partition not found, cannot revert"
		return 1
	fi

	# The rootfs UBI volume is SHARED across both banks - only the
	# kernel is genuinely per-slot (see the comment above
	# mercury_find_ubi_rootfs_dev() in lib/upgrade/mercury.sh). Reverting
	# just the boot-slot byte would point back at the OLD kernel while
	# leaving the NEW rootfs in place - old kernel against new rootfs is
	# exactly the mismatch this whole mechanism exists to prevent, just
	# introduced by the revert instead of the upgrade. Restore the
	# pre-upgrade rootfs backup first so kernel and rootfs land back on
	# the same known-good pairing together.
	echo "Mercury-Failsafe: restoring pre-upgrade rootfs to match slot $prev_slot's kernel..."
	mercury_restore_rootfs

	mercury_switch_boot_slot "/dev/mtd${config_mtd_num}" "$prev_slot"
	mercury_clear_pending
	sync
	reboot -f
}

mercury_pending_cleared() {
	mercury_mount_data 2>/dev/null || return 1
	local ret=1
	[ ! -f "$MERCURY_DATA_MOUNT/pending_boot" ] && ret=0
	mercury_umount_data
	return $ret
}

mercury_clear_pending() {
	if mercury_mount_data; then
		rm -f "$MERCURY_DATA_MOUNT/pending_boot"
		sync
		mercury_umount_data
	fi
}

mercury_looks_healthy() {
	ubus -t 3 call network.interface.lan status 2>/dev/null | grep -q '"up":[ ]*true' || return 1
	netstat -lnt 2>/dev/null | grep -q ':22[[:space:]]' || return 1
	return 0
}
