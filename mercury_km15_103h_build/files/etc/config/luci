config core 'main'
	option lang 'auto'
	option mediaurlbase '/luci-static/bootstrap'
	option resourcebase '/luci-static/resources'
	option ubuspath '/ubus/'

config internal 'languages'
	option auto 'Automatic'
	option en 'English'
	option ar 'العربية'

config internal 'themes'
	option Bootstrap '/luci-static/bootstrap'
	option OpenWrt2020 '/luci-static/openwrt2020'

config command 'extroot'
	option name 'Format USB & Expand Space (Extroot)'
	option command '/usr/bin/auto-extroot.sh'

config command 'eject'
	option name 'Safely Eject USB (Reboot to NAND)'
	option command '/usr/bin/safe-eject-usb.sh'

config command 'reconnect'
	option name 'Re-enable Existing USB (No Format)'
	option command '/usr/bin/enable-extroot.sh'
