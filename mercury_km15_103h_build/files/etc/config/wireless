config wifi-device 'radio0'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0'
	option channel '1'
	option band '2g'
	option htmode 'HE40'
	option country 'US'
	option cell_density '0'
	option txpower '30'
	# noscan: skip the OBSS (overlapping-BSS) scan so the AP does not
	# self-downgrade its width when neighbours are present. Required to
	# keep the widest channel; harmless on 2.4G HE40.
	option noscan '1'
	option disabled '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Mercury-KM15-2.4G'
	option encryption 'none'

config wifi-device 'radio1'
	option type 'mac80211'
	option path '1e140000.pcie/pci0000:00/0000:00:01.0/0000:02:00.0+1'
	option channel '36'
	option band '5g'
	# MT7915E in DBDC (Dual Band Concurrent) mode supports up to 80 MHz (HE80).
	# Note: Extended superchannels at 10 MHz spacing run in 20 MHz mode (HE20).
	option htmode 'HE80'
	option country 'US'
	option cell_density '0'
	option txpower '30'
	option noscan '1'
	option disabled '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Mercury-KM15-5G'
	option encryption 'none'
