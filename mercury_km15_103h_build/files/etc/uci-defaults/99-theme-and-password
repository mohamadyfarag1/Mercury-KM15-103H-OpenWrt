#!/bin/sh

# Ensure themes section exists in /etc/config/luci
uci -q get luci.themes >/dev/null || uci set luci.themes=internal
uci set luci.themes.Bootstrap='/luci-static/bootstrap'
uci set luci.themes.OpenWrt2020='/luci-static/openwrt2020'
uci set luci.main.mediaurlbase='/luci-static/bootstrap'

# Ensure languages section exists in /etc/config/luci
uci -q get luci.languages >/dev/null || uci set luci.languages=internal
uci set luci.languages.auto='Automatic'
uci set luci.languages.en='English'
uci set luci.languages.ar='العربية'

uci commit luci

# Ensure root password is set to 1234 if not already set
if ! grep -q '^root:\$1\$' /etc/shadow 2>/dev/null && ! grep -q '^root:\$6\$' /etc/shadow 2>/dev/null; then
    sed -i 's|^root:[^:]*|root:$1$horusnet$yI0r/ObXYqyWZfFMJ1Vcb0|' /etc/shadow
fi

exit 0
