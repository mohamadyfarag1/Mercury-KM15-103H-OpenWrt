#!/bin/sh
# Ensure port_control service is enabled and executable
[ -x /etc/init.d/port_control ] && /etc/init.d/port_control enable
chmod +x /usr/bin/port_control 2>/dev/null || true
chmod +x /etc/init.d/port_control 2>/dev/null || true
chmod +x /www/cgi-bin/port_action 2>/dev/null || true
mkdir -p /etc/horus/disabled_ports

# Purge LuCI cache on upgrade/boot
rm -rf /tmp/luci-indexcache* /tmp/luci-modulecache* 2>/dev/null || true

exit 0
