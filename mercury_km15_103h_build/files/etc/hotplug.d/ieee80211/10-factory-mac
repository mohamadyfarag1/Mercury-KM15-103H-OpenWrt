#!/bin/sh
# Set per-device WiFi MAC derived from eth0 factory MAC (programmed by U-Boot).
# Config partition is encrypted; the factory MAC is accessible only via the
# Ethernet hardware registers that U-Boot programs before booting Linux.
# Offset: phy0 (2.4 GHz) = base+2, phy1 (5 GHz) = base+3.

[ "$ACTION" = "add" ] || exit 0

PHY="$INTERFACE"
case "$PHY" in
	phy0) OFFSET=2 ;;
	phy1) OFFSET=3 ;;
	*) exit 0 ;;
esac

# Wait up to 3 s for eth0 to have a real (non-zero) MAC.
BASE_MAC=""
for _i in 1 2 3; do
	M=$(cat /sys/class/net/eth0/address 2>/dev/null)
	case "$M" in
		""|"00:00:00:00:00:00") sleep 1 ;;
		*) BASE_MAC="$M"; break ;;
	esac
done
[ -n "$BASE_MAC" ] || { logger -t factory-mac "eth0 MAC not ready, skipping $PHY"; exit 0; }

# Compute last byte + OFFSET (mod 256).
LAST=$(printf '%d' 0x"$(echo "$BASE_MAC" | cut -d: -f6)")
NEW_LAST=$(printf '%02x' $(( (LAST + OFFSET) & 0xFF )))
NEW_MAC="$(echo "$BASE_MAC" | sed "s/:[0-9a-f]\{2\}$/:${NEW_LAST}/")"

# Apply via iw (preferred) or ip link.
iw phy "$PHY" set macaddress "$NEW_MAC" 2>/dev/null || \
	ip link set "$PHY" address "$NEW_MAC" 2>/dev/null

logger -t factory-mac "$PHY MAC set to $NEW_MAC (base $BASE_MAC +$OFFSET)"
